ac_cv_buggy_getaddrinfo=no
ac_cv_file__dev_ptmx=yes
ac_cv_file__dev_ptc=no

# Fix the module import path, by telling Python it should look for modules in
# the regular scope, not the installed scope.
host_prefix=/usr

# Custom flag that we added that allows us to compile libhacl statically not for WASI.
ac_static_libhacl=yes

py_cv_module__decimal=n/a
py_cv_module_xxlimited=n/a
py_cv_module__crypt=n/a

py_cv_module_zlib=yes
py_cv_module__curses=yes
py_cv_module__curses_panel=yes

with_system_expat=yes